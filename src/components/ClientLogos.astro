---
import { getClients } from '../lib/content'
import { logoImage } from '../lib/image'

interface Props {
  /** How many logos the hero shows. Drag order in the Studio picks which. */
  limit?: number
}

const { limit = 5 } = Astro.props

/**
 * Optical sizing, not uniform sizing. A square mark and a wide wordmark set to
 * the same pixel height do not read as the same size — the square dominates.
 * Squarish logos get trimmed slightly so the row balances.
 */
const WORDMARK_HEIGHT = 28
const ICON_HEIGHT = 24
const heightFor = (aspect: number | null) =>
  aspect !== null && aspect < 1.6 ? ICON_HEIGHT : WORDMARK_HEIGHT

/**
 * Logos only — a name in text among four logos reads as a missing asset rather
 * than a client, so anything without a logo is skipped and the row simply
 * doesn't render until there are logos to show. Which five appear is the top
 * five in the Studio's Clients list; reordering there is the whole control.
 */
const clients = await getClients()

const logos = clients
  .map((client) => {
    const dimensions = client.logo?.asset?.metadata?.dimensions
    const height = heightFor(dimensions?.aspectRatio ?? null)
    return {
      name: client.name,
      invert: client.invertLogo,
      height,
      logo: logoImage(client.logo?.asset, height),
    }
  })
  .filter((entry) => entry.logo !== null)
  .slice(0, limit)
---

{
  logos.length > 0 && (
    <div class="mt-14">
      <p class="mb-4 text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-cinema-text/40">
        Selected clients
      </p>
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-5 sm:gap-x-10">
        {
          logos.map((entry) => (
            <li class="flex items-center">
              <img
                src={entry.logo!.src}
                srcset={entry.logo!.srcset ?? undefined}
                width={entry.logo!.width ?? undefined}
                height={entry.logo!.height ?? undefined}
                alt={entry.name}
                loading="eager"
                decoding="async"
                style={`height:${entry.height}px`}
                class:list={[
                  'w-auto max-w-[9rem] object-contain opacity-60 transition-opacity duration-200 hover:opacity-100',
                  entry.invert && 'brightness-0 invert',
                ]}
              />
            </li>
          ))
        }
      </ul>
    </div>
  )
}
