---
import { getClients } from '../lib/content'
import { logoImage } from '../lib/image'

/**
 * The client strip. Content comes entirely from the Clients list in the Studio —
 * add, rename, reorder or remove there and this section follows. It disappears
 * on its own when the list is empty, so an unfinished roster never ships as an
 * empty band.
 *
 * A client without a logo renders as its name, which is what keeps this from
 * being a half-populated grid while Artem gathers assets.
 */
const clients = await getClients()

const LOGO_HEIGHT = 40

const entries = clients.map((client) => ({
  name: client.name,
  website: client.website,
  invert: client.invertLogo,
  logo: logoImage(client.logo?.asset, LOGO_HEIGHT),
}))
---

{
  entries.length > 0 && (
    <section id="clients" class="border-y border-cinema-muted/60 bg-cinema-background py-12 md:py-16">
      <div class="container mx-auto">
        <h2 class="mb-8 text-center text-xs font-medium uppercase tracking-[0.2em] text-cinema-text/50">
          Trusted by
        </h2>

        <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-8 md:gap-x-14">
          {
            entries.map((entry) => {
              const inner = entry.logo ? (
                <img
                  src={entry.logo.src}
                  srcset={entry.logo.srcset ?? undefined}
                  width={entry.logo.width ?? undefined}
                  height={entry.logo.height ?? undefined}
                  alt={entry.name}
                  loading="lazy"
                  decoding="async"
                  style={`height:${LOGO_HEIGHT}px`}
                  class:list={[
                    'w-auto max-w-[10rem] object-contain opacity-70 transition-opacity duration-200 hover:opacity-100',
                    entry.invert && 'brightness-0 invert',
                  ]}
                />
              ) : (
                /* No logo yet — the name carries the same information. */
                <span class="text-lg font-medium text-cinema-text/60 transition-colors duration-200 hover:text-cinema-text">
                  {entry.name}
                </span>
              )

              return (
                <li class="flex items-center">
                  {entry.website ? (
                    <a
                      href={entry.website}
                      rel="noopener noreferrer"
                      target="_blank"
                      class="flex items-center"
                      aria-label={entry.name}
                    >
                      {inner}
                    </a>
                  ) : (
                    inner
                  )}
                </li>
              )
            })
          }
        </ul>
      </div>
    </section>
  )
}
