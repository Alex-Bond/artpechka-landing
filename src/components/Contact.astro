---
import ContactForm from './islands/ContactForm'

const EMAIL = 'hi@artpechka.com'
const MAILTO =
  'mailto:hi@artpechka.com?subject=Inquiry%20from%20the%20website&body=Hi%20Arty!%0A%0AI%20have%20a%20project%20for%20you%20-%20'

const details = [
  {
    label: 'Email',
    value: EMAIL,
    href: MAILTO,
    icon: 'M4 4h16v16H4z M22 6l-10 7L2 6',
  },
  {
    label: 'Phone · WhatsApp',
    value: '+380 (93) 142-2390',
    href: 'tel:+380931422390',
    icon: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z',
  },
  {
    label: 'Telegram',
    value: '@artpechka',
    href: 'https://t.me/artpechka',
    icon: 'M22 2L11 13 M22 2l-7 20-4-9-9-4 20-7z',
  },
  {
    label: 'IMDb',
    value: 'Credits on IMDb',
    href: 'https://www.imdb.com/name/nm13116969/',
    // Film strip: IMDb is a credits registry, not a social feed.
    icon: 'M7 3v18 M17 3v18 M3 7.5h4 M3 12h18 M3 16.5h4 M17 7.5h4 M17 16.5h4 M3 3h18v18H3z',
  },
  {
    label: 'Location',
    value: 'Kyiv, Ukraine',
    href: null,
    icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  },
]
---

<section id="contact" class="section-padding bg-cinema-muted">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div>
        <h2 class="mb-2 text-sm font-medium text-cinema-accent">GET IN TOUCH</h2>
        <h3 class="mb-6 text-3xl font-bold md:text-4xl">Let's Work Together</h3>
        <p class="mb-8 text-cinema-text/70">
          Whether you have a project in mind or just want to say hello, I'd love to hear from you.
          Fill out the form or use my contact details below to get in touch.
        </p>

        <div class="mb-8 space-y-6">
          {
            details.map((detail) => (
              <div class="flex items-start gap-4">
                <div class="rounded-md bg-cinema-background p-3 text-cinema-accent">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {detail.icon.split(' M').map((segment, index) => (
                      <path d={index === 0 ? segment : `M${segment}`} />
                    ))}
                  </svg>
                </div>
                <div>
                  <h4 class="mb-1 font-medium">{detail.label}</h4>
                  {detail.href ? (
                    <a
                      href={detail.href}
                      class="text-cinema-text/70 transition-colors hover:text-cinema-accent"
                      rel={detail.href.startsWith('http') ? 'noopener' : undefined}
                    >
                      {detail.value}
                    </a>
                  ) : (
                    <p class="text-cinema-text/70">{detail.value}</p>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <ContactForm email={EMAIL} client:visible />
    </div>
  </div>
</section>
