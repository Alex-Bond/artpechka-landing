---
import ClientLogos from './ClientLogos.astro'
---

<section
  id="home"
  class="relative flex min-h-screen items-center bg-cinema-background pt-20"
>
  <div
    class="absolute inset-0 bg-gradient-to-r from-cinema-accent/10 to-cinema-highlight/10 opacity-40"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 opacity-5"
    aria-hidden="true"
    style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 50px 50px;"
  >
  </div>

  <div class="container relative z-10 mx-auto">
    <div class="max-w-3xl">
      <h1
        class="mb-6 text-4xl font-bold leading-tight md:text-5xl lg:text-7xl md:[@media(max-height:700px)]:text-5xl"
      >
        A modern video editor, <span class="text-gradient">colorist</span> and filmmaker.
      </h1>
      <p class="mb-8 max-w-2xl text-lg text-cinema-text/80 md:text-xl">
        From YouTube vlogs, reviews and creator-led online content to vertical drama series and
        commercials for small and big brands — more than a decade of editing, grading and shooting.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href="#portfolio" class="btn-primary">View My Work</a>
      </div>

      <ClientLogos limit={5} />
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <div class="flex h-10 w-6 justify-center rounded-full border-2 border-cinema-text/30">
      <div class="mt-2 h-3 w-1 rounded-full bg-cinema-text/30"></div>
    </div>
  </div>
</section>
