{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "sanity",
    "scripts",
    "api",
    "sanity.config.ts",
    "sanity.cli.ts",
    "astro.config.mjs"
  ],
  "exclude": ["dist", ".vercel"]
}
